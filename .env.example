# GRVTBot — Environment Variables
# Copy this file to .env and fill in the values before starting.
# NEVER commit .env to git — it is covered by .gitignore.
#
# Required variables are marked [REQUIRED].
# Optional variables show their default in the comment.

# ─────────────────────────────────────────────────────────────────────────────
# AUTH — JWT & API Security                                           [REQUIRED]
# ─────────────────────────────────────────────────────────────────────────────

# HS256 signing secret for all JWTs. Must be at least 32 characters.
# Generate: openssl rand -base64 48
JWT_SECRET=

# Legacy X-Api-Key used by scripts/curl calls that bypass JWT auth.
# Generate: openssl rand -hex 32
DASHBOARD_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# MASTER KEY — AES-256-GCM encryption for GRVT credentials at rest   [REQUIRED]
# ─────────────────────────────────────────────────────────────────────────────

# Path to the 32-byte binary key file used to encrypt/decrypt GRVT API secrets.
# Docker: mount a host path to /app/data and point this to /app/data/master.key
# Generate: openssl rand -out /app/data/master.key 32
MASTER_KEY_PATH=/app/data/master.key

# ─────────────────────────────────────────────────────────────────────────────
# FIRST-BOOT OWNER BOOTSTRAP                                          [REQUIRED]
# ─────────────────────────────────────────────────────────────────────────────

# Email + password for the initial owner account seeded on first start.
# The owner is automatically granted admin privileges.
# Clear or remove after first boot to prevent re-seeding.
OWNER_EMAIL=admin@example.com
OWNER_INITIAL_PASSWORD=

# Email that is auto-granted admin role on signup (can be the same as OWNER_EMAIL).
ADMIN_EMAIL=admin@example.com

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION URL                                                      [REQUIRED]
# ─────────────────────────────────────────────────────────────────────────────

# Full public base URL of the dashboard — no trailing slash.
# Used to build password-reset links in emails.
# Must be set explicitly: deriving from the Host header is blocked to prevent
# token leakage via a spoofed Host header.
APP_BASE_URL=https://your-domain.example.com

# ─────────────────────────────────────────────────────────────────────────────
# GRVT CREDENTIALS — optional (can be entered via dashboard UI instead)
# ─────────────────────────────────────────────────────────────────────────────

# Leave blank to enter credentials through the dashboard Settings page.
# Generate from your GRVT account at https://grvt.io
GRVT_API_KEY=
GRVT_API_SECRET=
GRVT_TRADING_ADDRESS=
GRVT_ACCOUNT_ID=
GRVT_TRADING_ACCOUNT_ID=
GRVT_TRADING_URL=

# ─────────────────────────────────────────────────────────────────────────────
# DASHBOARD PORT & LEGACY AUTH                                         [optional]
# ─────────────────────────────────────────────────────────────────────────────

# Port the bot HTTP server listens on.  Default: 3848
DASHBOARD_PORT=3848

# Basic auth for the legacy v1 HTML dashboard (not the React SPA).
# Remove once fully migrated to the v2 dashboard at /dashboard/.
DASHBOARD_USER=admin
DASHBOARD_PASS=

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL — password reset                                               [optional]
# ─────────────────────────────────────────────────────────────────────────────

# SMTP configuration for transactional email (password reset links).
# Leave blank to disable email sending — reset URLs will appear in server logs
# at WARN level so the admin can deliver them out-of-band.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# ─────────────────────────────────────────────────────────────────────────────
# METRICS — Prometheus scraping                                        [optional]
# ─────────────────────────────────────────────────────────────────────────────

# Bearer token for GET /api/v2/metrics. Must be at least 16 characters.
# Leave blank to disable the metrics endpoint entirely.
# Generate: openssl rand -hex 16
METRICS_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# LOGGING & SECURITY HEADERS                                           [optional]
# ─────────────────────────────────────────────────────────────────────────────

# Log level: info | debug | warn | error  (default: info)
LOG_LEVEL=info

# Set to 1 to send Content-Security-Policy headers on all responses.
# Recommended for production.  Default: disabled
ENABLE_CSP=1

# ─────────────────────────────────────────────────────────────────────────────
# NOTIFIER SERVICE — required only when using the notifier Docker profile
# ─────────────────────────────────────────────────────────────────────────────

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Chat ID where alerts are sent (your personal chat or a group).
# Retrieve via: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# Telegram user ID of the operator.
# Only bots owned by this user trigger Telegram alerts.
# Find your ID via @userinfobot on Telegram.
OPERATOR_USER_ID=

# Optional webhook for additional alert destinations (Slack, Discord, etc.).
WEBHOOK_URL=
WEBHOOK_SECRET=

# Alert thresholds.  (notifier defaults apply when blank)
NOTIFY_DRAWDOWN_PCT=5
NOTIFY_FILL_BATCH=10
NOTIFY_LIQ_PROXIMITY_PCT=10

# Hour of day (UTC, 0-23) for the daily portfolio summary.  Default: 8
DAILY_SUMMARY_HOUR_UTC=8

# Muted hours — no alerts fired between start and end (UTC).  Leave blank to disable.
MUTED_HOURS_START_UTC=
MUTED_HOURS_END_UTC=

# Notifier polling interval in milliseconds.  Default: 10000
NOTIFIER_POLL_MS=10000

# Directory for notifier state files.  Default: /app/state in Docker
NOTIFIER_STATE_DIR=/app/state

# Port for the notifier health check endpoint.  Default: 3849
NOTIFIER_HEALTH_PORT=3849

# Path to the shared SQLite database.
# Set automatically by docker-compose — override only if running notifier outside Docker.
GRID_BOT_DB=/app/data/grid_bot.db

# ─────────────────────────────────────────────────────────────────────────────
# DEVELOPMENT / TEST ONLY — do not set in production
# ─────────────────────────────────────────────────────────────────────────────

# NODE_ENV=development
# DISABLE_RATE_LIMIT=1    # disables all rate limiters (auth + mutation)
# DRY_RUN=true            # skips real GRVT order placement
# MOCK_MODE=true          # uses mock GRVT client — no exchange calls made
